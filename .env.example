# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildup"

# JWT session secret — generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-random-secret"

# Internal service secret (socket relay)
INTERNAL_SECRET="change-me-to-another-random-secret"

# Demo password for seed users
DEMO_PASSWORD="password123"

# Seed endpoint secret — set this and pass as Bearer token to use /api/seed
SEED_SECRET="change-me-to-a-random-secret"

# Email (configure for verification & password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=BuildUp <noreply@buildup.com>

# App URL (used for verification/reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enable demo login buttons on the login page (set to 'true' for dev, 'false' for production)
NEXT_PUBLIC_ENABLE_DEMO=false
